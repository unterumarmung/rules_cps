package(default_visibility = ["//visibility:public"])

load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("//cps/private:compatibility_types.bzl", "cps_aware_hint")

exports_files([
    "BUILD.bazel",
    "defs.bzl",
    "extensions.bzl",
    "providers.bzl",
])

filegroup(
    name = "all_sources",
    srcs = glob(["*.bzl"]) + ["BUILD.bazel"],
)

bzl_library(
    name = "providers",
    srcs = ["providers.bzl"],
)

bool_flag(
    name = "compatibility_aspect_enabled",
    build_setting_default = False,
)

cps_aware_hint(name = "_aware_hint")
