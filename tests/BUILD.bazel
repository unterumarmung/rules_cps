load("@rules_cps//cps:defs.bzl", "cc_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":provider_test.bzl", "provider_test_suite")
load(":nonhermetic_test.bzl", "nonhermetic_test_suite")

exports_files(["assert_imported_link_plan.sh"])

provider_test_suite(name = "provider_tests")
nonhermetic_test_suite(name = "nonhermetic_tests")

sh_test(
    name = "nested_archive_repository_test",
    srcs = ["import_basic_test.sh"],
    data = [
        "//:MODULE.bazel",
        "//cps:all_sources",
        "//cps/private:all_sources",
        "//tests/fixtures/basic:BUILD.bazel",
        "//tests/fixtures/basic:basic.tar.gz",
        "//tests/fixtures/basic:package_tree",
        "//tests/fixtures/cycle:BUILD.bazel",
        "//tests/fixtures/cycle:package_tree",
        "//tests/export:roundtrip_component",
        "//tests/export:roundtrip_package",
        "//tests/export:imported_headers_component",
        "//tests/export:imported_static_component",
        "//tests/export:imported_roundtrip_package",
        "//tests/export:imported_roundtrip_payload",
        "//tests/export_roundtrip:all_files",
        "//tests/import_basic:all_files",
        "//tests/module_cases:all_files",
    ],
    env_inherit = ["PATH"],
    size = "large",
    tags = ["exclusive", "nested"],
)

sh_test(
    name = "cmake_interoperability_test",
    srcs = ["//tests/cmake_interop:cmake_interop_test.sh"],
    data = [
        "//:MODULE.bazel",
        "//cps:all_sources",
        "//cps/private:all_sources",
        "//tests/cmake_interop:all_files",
        "//tests/export:cmake_component",
        "//tests/export:cmake_package",
    ],
    env_inherit = ["PATH"],
    size = "large",
    tags = ["exclusive", "nested"],
)

config_setting(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)

constraint_setting(name = "abi")
constraint_value(name = "custom_abi", constraint_setting = ":abi", visibility = ["//visibility:public"])

platform(
    name = "custom_host_platform",
    constraint_values = [":custom_abi"],
    parents = ["@platforms//host:host"],
)

config_setting(
    name = "opt_mode",
    values = {"compilation_mode": "opt"},
)

